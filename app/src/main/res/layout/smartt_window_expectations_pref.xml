<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dsl_settings_gutter"
    android:paddingEnd="@dimen/dsl_settings_gutter">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/CommunicationWindow__check_frequency"
        android:textAppearance="@style/TextAppearance.Signal.Body2.Bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/check_frequency_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/CommunicationWindow__usual_reply_time"
        android:textAppearance="@style/TextAppearance.Signal.Body2.Bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/usual_reply_time_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/CommunicationWindow__personal_note"
        android:textAppearance="@style/TextAppearance.Signal.Body2.Bold" />

    <EditText
        android:id="@+id/personal_note_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_rectangle"
        android:gravity="top|start"
        android:hint="@string/CommunicationWindow__personal_note_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="3"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.Signal.Body1" />

</LinearLayout>
