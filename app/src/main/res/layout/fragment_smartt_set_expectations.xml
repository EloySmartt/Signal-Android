<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/dsl_settings_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dsl_settings_gutter"
            android:paddingEnd="@dimen/dsl_settings_gutter"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/CommunicationWindow__set_expectations"
                android:textAppearance="@style/TextAppearance.Signal.Title1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/CommunicationWindow__set_expectations_description"
                android:textAppearance="@style/TextAppearance.Signal.Body1"
                android:textColor="@color/signal_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/CommunicationWindow__check_frequency"
                android:textAppearance="@style/TextAppearance.Signal.Body2.Bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/check_frequency_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/CommunicationWindow__usual_reply_time"
                android:textAppearance="@style/TextAppearance.Signal.Body2.Bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/usual_reply_time_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/CommunicationWindow__personal_note"
                android:textAppearance="@style/TextAppearance.Signal.Body2.Bold" />

            <EditText
                android:id="@+id/personal_note_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_rectangle"
                android:gravity="top|start"
                android:hint="@string/CommunicationWindow__personal_note_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.Signal.Body1" />

        </LinearLayout>
    </ScrollView>

    <org.thoughtcrime.securesms.util.views.CircularProgressMaterialButton
        android:id="@+id/next_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/dsl_settings_gutter"
        android:layout_marginBottom="@dimen/dsl_settings_gutter"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:circularProgressMaterialButton__label="@string/CommunicationWindow__next" />

</LinearLayout>
