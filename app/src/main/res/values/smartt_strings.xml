    <string name="SmarttParental_filter__section_title">AI content filter</string>
    <!-- Caption of the AI content filter section -->
    <string name="SmarttParental_filter__section_caption">Every image and video is analysed on this phone before it is rendered — the media never leaves the device and is never sent to a server. Typical decision time: 120 ms.</string>
    <!-- Title of the switch enabling the AI media filter -->
    <string name="SmarttParental_filter__master_title">Filter media with AI</string>
    <!-- Detail of the AI media filter switch when on. First placeholder is the number of enabled categories, second is the total. -->
    <string name="SmarttParental_filter__master_detail_on">%1$d of %2$d categories active</string>
    <!-- Detail of the AI media filter switch when off -->
    <string name="SmarttParental_filter__master_detail_off">Off — Marc sees everything they receive</string>
    <!-- Subheading above the filter sensitivity selector -->
    <string name="SmarttParental_filter__sensitivity_subhead">Sensitivity</string>
    <!-- Least strict filter sensitivity option -->
    <string name="SmarttParental_filter__sensitivity_low">Low</string>
    <!-- Middle filter sensitivity option -->
    <string name="SmarttParental_filter__sensitivity_balanced">Balanced</string>
    <!-- Most strict filter sensitivity option -->
    <string name="SmarttParental_filter__sensitivity_strict">Strict</string>
    <!-- Explanation of the low filter sensitivity option -->
    <string name="SmarttParental_filter__sensitivity_low_hint">Only clear-cut cases. Fewest false positives, some borderline content gets through.</string>
    <!-- Explanation of the balanced filter sensitivity option -->
    <string name="SmarttParental_filter__sensitivity_balanced_hint">Recommended for 9–13. Flags borderline content and asks you when unsure.</string>
    <!-- Explanation of the strict filter sensitivity option -->
    <string name="SmarttParental_filter__sensitivity_strict_hint">Blocks anything even slightly suggestive. Expect a few harmless photos to be held.</string>
    <!-- Subheading above the list of content categories that can be blocked -->
    <string name="SmarttParental_filter__categories_subhead">What to block</string>

    <!-- Blocked category: nudity, title -->
    <string name="SmarttParental_category__sexual_title">Nudity &amp; sexual content</string>
    <!-- Blocked category: nudity, description -->
    <string name="SmarttParental_category__sexual_detail">Photos, videos, GIFs and stickers. Also catches partial nudity and suggestive poses.</string>
    <!-- Blocked category: violence, title -->
    <string name="SmarttParental_category__violence_title">Violence &amp; gore</string>
    <!-- Blocked category: violence, description -->
    <string name="SmarttParental_category__violence_detail">Fights, blood, injuries, animal cruelty and graphic accidents.</string>
    <!-- Blocked category: weapons, title -->
    <string name="SmarttParental_category__weapons_title">Weapons</string>
    <!-- Blocked category: weapons, description -->
    <string name="SmarttParental_category__weapons_detail">Firearms, knives and airsoft replicas held or pointed at people.</string>
    <!-- Blocked category: drugs, title -->
    <string name="SmarttParental_category__drugs_title">Drugs, alcohol &amp; vaping</string>
    <!-- Blocked category: drugs, description -->
    <string name="SmarttParental_category__drugs_detail">Substances, paraphernalia and vape devices in frame.</string>
    <!-- Blocked category: self-harm, title -->
    <string name="SmarttParental_category__selfharm_title">Self-harm</string>
    <!-- Blocked category: self-harm, description -->
    <string name="SmarttParental_category__selfharm_detail">Cuts, scars and pro-self-harm imagery. Always alerts you, never silently.</string>
    <!-- Blocked category: hate speech, title -->
    <string name="SmarttParental_category__hate_title">Hate speech &amp; symbols</string>
    <!-- Blocked category: hate speech, description -->
    <string name="SmarttParental_category__hate_detail">Slurs in text and extremist symbols in images.</string>
    <!-- Blocked category: scams and phishing, title -->
    <string name="SmarttParental_category__scams_title">Scams, phishing &amp; adult links</string>
    <!-- Blocked category: scams and phishing, description -->
    <string name="SmarttParental_category__scams_detail">Checks every link and its preview before the child can tap it.</string>
    <!-- Blocked category: profanity, title -->
    <string name="SmarttParental_category__profanity_title">Profanity in text</string>
    <!-- Blocked category: profanity, description -->
    <string name="SmarttParental_category__profanity_detail">Masks strong language instead of hiding the whole message.</string>

    <!-- Subheading above the selector for what happens to blocked media -->
    <string name="SmarttParental_filter__action_subhead">When something is caught</string>
    <!-- Option to blur blocked media and explain why -->
    <string name="SmarttParental_filter__action_blur">Blur &amp; warn</string>
    <!-- Option to hide blocked media -->
    <string name="SmarttParental_filter__action_hide">Hide</string>
    <!-- Option to delete blocked media -->
    <string name="SmarttParental_filter__action_delete">Delete</string>
    <!-- Explanation of the blur option -->
    <string name="SmarttParental_filter__action_blur_hint">The child sees a blurred placeholder and a note explaining why. Nothing is deleted.</string>
    <!-- Explanation of the hide option -->
    <string name="SmarttParental_filter__action_hide_hint">The message is removed from the chat and moved to your review queue.</string>
    <!-- Explanation of the delete option -->
    <string name="SmarttParental_filter__action_delete_hint">The media is deleted from the device immediately. You still get the alert.</string>

    <!-- Title of the switch that also scans media the child sends -->
    <string name="SmarttParental_filter__scan_outgoing_title">Scan outgoing media too</string>
    <!-- Detail of the switch that also scans media the child sends -->
    <string name="SmarttParental_filter__scan_outgoing_detail">Stops Marc sending nudes or sensitive photos, and warns them before it leaves the phone.</string>
    <!-- Title of the switch that keeps a log of blocked media -->
    <string name="SmarttParental_filter__keep_log_title">Keep a log of what was blocked</string>
    <!-- Detail of the switch that keeps a log of blocked media -->
    <string name="SmarttParental_filter__keep_log_detail">Sender, category and a safe thumbnail, saved on this phone. Only readable with your PIN.</string>
    <!-- Title of the switch letting the child report a wrong block -->
    <string name="SmarttParental_filter__child_flag_title">Let Marc flag a mistake</string>
    <!-- Detail of the switch letting the child report a wrong block -->
    <string name="SmarttParental_filter__child_flag_detail">Marc can mark a block as wrong instead of being stuck. It waits in the review queue for the next time you have the phone.</string>
    <!-- Row leading to the queue of media held on this phone -->
    <string name="SmarttParental_filter__review_row">Review what was held on this phone</string>

    <!-- Title of the communication windows section -->
    <string name="SmarttParental_windows__section_title">Communication windows</string>
    <!-- Caption of the communication windows section -->
    <string name="SmarttParental_windows__section_caption">Messages, mail and calls keep arriving in the background, but this phone only shows them to Marc inside the windows you set here. No buzzing during class, no scrolling at midnight.</string>
    <!-- Title of the switch limiting when messages are shown to the child -->
    <string name="SmarttParental_windows__master_title">Limit when messages are delivered</string>
    <!-- Detail of the delivery window switch when off -->
    <string name="SmarttParental_windows__master_detail_off">Off — Marc receives everything as it arrives</string>
    <!-- Name of the preset weekday window -->
    <string name="SmarttParental_windows__after_school">After school</string>
    <!-- Name of the preset weekend window -->
    <string name="SmarttParental_windows__weekend">Weekend</string>
    <!-- A window\'s time range. First placeholder is the start time, second the end time. -->
    <string name="SmarttParental_windows__time_range">%1$s–%2$s</string>
    <!-- Shown instead of the day letters when a window is active every day -->
    <string name="SmarttParental_windows__every_day">Every day</string>
    <!-- Subheading above the selector for what happens outside a window -->
    <string name="SmarttParental_windows__outside_subhead">Outside the window</string>
    <!-- Option holding messages back until the window opens -->
    <string name="SmarttParental_windows__outside_hold">Hold until it opens</string>
    <!-- Option delivering messages silently outside the window -->
    <string name="SmarttParental_windows__outside_silent">Deliver silently</string>
    <!-- Explanation of the hold option -->
    <string name="SmarttParental_windows__outside_hold_hint">Messages are downloaded and encrypted on this phone, but stay invisible until the window opens.</string>
    <!-- Explanation of the deliver silently option -->
    <string name="SmarttParental_windows__outside_silent_hint">Messages appear with no sound, no vibration and no badge. Marc can still look.</string>
    <!-- Title of the overnight lock switch -->
    <string name="SmarttParental_windows__bedtime_title">Bedtime lock · 21:30 – 07:30</string>
    <!-- Detail of the overnight lock switch -->
    <string name="SmarttParental_windows__bedtime_detail">Nothing is delivered and the app cannot be opened, not even inside a window.</string>
    <!-- Title of the switch applying windows to calls as well -->
    <string name="SmarttParental_windows__calls_title">Calls follow the same windows</string>
    <!-- Detail of the switch applying windows to calls as well -->
    <string name="SmarttParental_windows__calls_detail">Outside the window, calls are logged as missed and shown when the window opens.</string>
    <!-- Subheading above the contacts that can always reach the child -->
    <string name="SmarttParental_windows__allowed_subhead">Always allowed</string>
    <!-- Always allowed contact: the child\'s mother -->
    <string name="SmarttParental_windows__allowed_mum">Mum</string>
    <!-- Always allowed contact: the child\'s father -->
    <string name="SmarttParental_windows__allowed_dad">Dad</string>
    <!-- Always allowed contact: the child\'s grandmother -->
    <string name="SmarttParental_windows__allowed_grandma">Grandma</string>
    <!-- Always allowed contact: the emergency services number -->
    <string name="SmarttParental_windows__allowed_emergency">Emergency (112)</string>
    <!-- Chip for adding another always allowed contact -->
    <string name="SmarttParental_windows__allowed_add">+ Add</string>
    <!-- Explanation of the always allowed contacts -->
    <string name="SmarttParental_windows__allowed_hint">These contacts break through every window, the bedtime lock included. Add your own number before you hand the phone back.</string>

    <!-- Title of the contacts and digest section -->
    <string name="SmarttParental_contacts__section_title">Contacts &amp; digest</string>
    <!-- Caption of the contacts and digest section -->
    <string name="SmarttParental_contacts__section_caption">Anything held back waits on this phone until you unlock these settings again — nothing is forwarded to you.</string>
    <!-- Title of the switch restricting who can message the child -->
    <string name="SmarttParental_contacts__approved_title">Only approved contacts can write</string>
    <!-- Detail of the switch restricting who can message the child -->
    <string name="SmarttParental_contacts__approved_detail">Anyone new is held on this phone instead of appearing in Marc’s chat list.</string>
    <!-- Title of the switch restricting who can email the child -->
    <string name="SmarttParental_contacts__mail_title">Mail from approved senders only</string>
    <!-- Detail of the switch restricting who can email the child -->
    <string name="SmarttParental_contacts__mail_detail">Newsletters and unknown addresses stay held until you release them here.</string>
    <!-- Title of the weekly digest switch -->
    <string name="SmarttParental_contacts__digest_title">Weekly digest on this phone</string>
    <!-- Detail of the weekly digest switch -->
    <string name="SmarttParental_contacts__digest_detail">What was blocked, who is new and how much window time was used — ready to read the next time you unlock these settings.</string>

    <!-- Title of the parent PIN section -->
    <string name="SmarttParental_pin__section_title">Parent PIN</string>
    <!-- Caption of the parent PIN section -->
    <string name="SmarttParental_pin__section_caption">You and Marc share one device, so the PIN is the only thing separating what you can change from what Marc can. Pick something Marc will not guess or watch you type.</string>
    <!-- Title of the switch requiring a PIN to change these settings -->
    <string name="SmarttParental_pin__require_title">Require PIN to change these settings</string>
    <!-- Detail of the switch requiring a PIN to change these settings -->
    <string name="SmarttParental_pin__require_detail">Without it, Marc can turn the filter and the windows off as soon as you hand the phone back.</string>
    <!-- Row for changing the parent PIN -->
    <string name="SmarttParental_pin__change_row">Change parent PIN</string>

    <!-- Small print at the bottom of the Parental Control screen. Placeholder is the app name. -->
    <string name="SmarttParental_legal__body">Prototype only — no model is running and nothing is enforced. Detection happens on-device in the real product: there is no parent app, no paired device and no account to link, and %1$s never receives Marc’s photos or messages.</string>
    <!-- Button that locks the Parental Control settings before handing the phone to the child -->
    <string name="SmarttParental_footer__lock">Lock settings &amp; hand the phone back</string>

    <!-- Detail of the delivery window switch when on, counting the configured windows -->
    <plurals name="SmarttParental_windows__master_detail_on">
        <item quantity="one">%1$d window configured</item>
        <item quantity="other">%1$d windows configured</item>
    </plurals>
</resources>
