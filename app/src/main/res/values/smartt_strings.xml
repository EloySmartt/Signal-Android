    <!-- Connect WhatsApp feature -->
    <!-- Title of the Connect WhatsApp entry card shown at the top of the chat list -->
    <string name="ConnectWhatsApp_card__title">Connect WhatsApp</string>
    <!-- Subtitle of the Connect WhatsApp entry card. Placeholder is the app name. -->
    <string name="ConnectWhatsApp_card__subtitle">Reach WhatsApp contacts within %1$s</string>
    <!-- Label of the pill button on the Connect WhatsApp entry card -->
    <string name="ConnectWhatsApp_card__action">Connect</string>

    <!-- Title of the intro bottom sheet. Placeholder is the app name. -->
    <string name="ConnectWhatsApp_intro__title">Bring WhatsApp within %1$s</string>
    <!-- Subtitle of the intro bottom sheet. Placeholder is the app name. -->
    <string name="ConnectWhatsApp_intro__subtitle">Chat with WhatsApp contacts on your terms from %1$s — you decide when messages reach you.</string>
    <!-- Intro bottom sheet, first info row title -->
    <string name="ConnectWhatsApp_intro__row_windows_title">Your windows, your rules</string>
    <!-- Intro bottom sheet, first info row description -->
    <string name="ConnectWhatsApp_intro__row_windows_body">When you’re closed, WhatsApp messages wait quietly and arrive the moment your window opens.</string>
    <!-- Intro bottom sheet, second info row title -->
    <string name="ConnectWhatsApp_intro__row_reply_title">Reply when you want to</string>
    <!-- Intro bottom sheet, second info row description. Placeholder is the app name. -->
    <string name="ConnectWhatsApp_intro__row_reply_body">Send messages anytime from %1$s. Your contacts use WhatsApp normally — they won’t see your window status.</string>
    <!-- Intro bottom sheet, third info row title -->
    <string name="ConnectWhatsApp_intro__row_inbox_title">One inbox, one focus</string>
    <!-- Intro bottom sheet, third info row description. Placeholder is the app name. -->
    <string name="ConnectWhatsApp_intro__row_inbox_body">WhatsApp chats live right here alongside %1$s, under the same focus rules.</string>
    <!-- Intro bottom sheet footnote about WhatsApp\'s official API. Placeholder is the app name. -->
    <string name="ConnectWhatsApp_intro__footnote">Connected via WhatsApp’s official API. %1$s never stores your messages.</string>
    <!-- Primary button on the intro bottom sheet -->
    <string name="ConnectWhatsApp_intro__action">Link WhatsApp account</string>

